# Copy to studio/.env (never commit .env).

# Postiz on the Azure VM
POSTIZ_URL=https://your-postiz-host.example
POSTIZ_API_KEY=

# Postiz integration (channel) IDs. Defaults for Instagram + YouTube are in config.yaml;
# set these only to override. A blank channel means those posts are skipped (logged), not errored.
LAYER8_IG_CHANNEL_ID=
LOFI_IG_CHANNEL_ID=
YOUTUBE_LAYER8_CHANNEL_ID=
YOUTUBE_LOFI_CHANNEL_ID=
TIKTOK_CHANNEL_ID=

# Optional run summaries
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Optional premium video (Higgsfield). Format: key_id:key_secret
HIGGSFIELD_API_KEY=
