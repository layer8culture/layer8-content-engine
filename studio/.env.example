# Copy to studio/.env (never commit .env).

# Postiz on the Azure VM
POSTIZ_URL=https://your-postiz-host.example
POSTIZ_API_KEY=

# Postiz integration (channel) IDs. Instagram defaults come from config.yaml; YouTube has none —
# leave blank and those posts are skipped (logged), not errored.
LAYER8_IG_CHANNEL_ID=
LOFI_IG_CHANNEL_ID=
YOUTUBE_LAYER8_CHANNEL_ID=
YOUTUBE_LOFI_CHANNEL_ID=
TIKTOK_CHANNEL_ID=

# Optional run summaries
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Optional premium video (Higgsfield). Format: key_id:key_secret
HIGGSFIELD_API_KEY=
